{
  "name": "olubunmi-tunji-ojo-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/check-sources.ts && tsc --noEmit && vite build && bun scripts/prerender.ts",
    "preview": "vite preview",
    "check": "bun scripts/check-sources.ts && tsc --noEmit",
    "test:e2e": "playwright test",
    "cms:build": "SITE_URL=https://olubunmitunjiojo.com/ bun run build && cd cms && bun run prepare:assets && bun run build:worker",
    "cms:dev": "cd cms && bun run dev"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
